    "title" : "Generic Linux bundler"
  },
  "primaryContentSections" : [
    {
      "content" : [
        {
          "anchor" : "Overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The generic Linux bundler generates a directory structure—reminiscent of the structure laid out by the ",
              "type" : "text"
            },
            {
              "identifier" : "https:\/\/en.wikipedia.org\/wiki\/Filesystem_Hierarchy_Standard",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : "—that houses your main executable, required dynamic libraries, and resources.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "It is the recommended bundler to use during Linux development, as it’s the fastest, and produces the most inspectable output bundle. If you wish, you can also use this bundler to distribute your application by archiving the resulting directory (as long as you tell your users to install required system dependencies).",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "This bundler forms the base for all of the other Linux bundlers.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Usage",
          "level" : 2,
          "text" : "Usage",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "In all of the following examples you can omit ",
              "type" : "text"
            },
            {
              "code" : "--bundler genericLinux",
              "type" : "codeVoice"
            },
            {
              "text" : " because it is the default when targeting Linux.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Create-an-app-bundle",
          "level" : 3,
          "text" : "Create an app bundle",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler bundle --bundler genericLinux"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "anchor" : "Run-on-your-host-machine",
          "level" : 3,
          "text" : "Run on your host machine",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler run --bundler genericLinux"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        }
      ],
      "kind" : "content"
    }
