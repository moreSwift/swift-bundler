{
  "abstract" : [
    {
      "text" : "A bundler that produces Linux RPM installers.",
      "type" : "text"
    }
  ],
  "hierarchy" : {
    "paths" : [
      [
        "doc:\/\/swift-bundler\/documentation\/swift-bundler",
