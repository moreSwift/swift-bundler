  "primaryContentSections" : [
    {
      "content" : [
        {
          "anchor" : "Overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The APK bundler is the recommended bundler to use when developing and",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "distributing Android applications.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Usage",
          "level" : 2,
          "text" : "Usage",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "You can omit ",
              "type" : "text"
            },
            {
              "code" : "--bundler androidAPK",
              "type" : "codeVoice"
            },
            {
              "text" : " when Swift Bundler can infer that the target platform is ",
              "type" : "text"
            },
            {
              "code" : "Android",
              "type" : "codeVoice"
            },
            {
              "text" : ", because the default Android bundler is the APK bundler. This includes using the ",
              "type" : "text"
            },
            {
              "code" : "--platform android",
              "type" : "codeVoice"
            },
            {
              "text" : " argument to specifically target Android.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Create-an-APK",
          "level" : 3,
          "text" : "Create an APK",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler bundle --bundler androidAPK"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "anchor" : "Create-an-optimized-APK",
          "level" : 3,
          "text" : "Create an optimized APK",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler bundle --bundler androidAPK -c release --strip"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "anchor" : "Run-on-an-Android-device",
          "level" : 3,
          "text" : "Run on an Android device",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler run --device \"Your Pixel 8a\""
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "anchor" : "Run-on-an-Android-emulator",
          "level" : 3,
          "text" : "Run on an Android emulator",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler run --simulator \"Pixel 8a\""
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        }
      ],
      "kind" : "content"
    }
