        },
        {
          "inlineContent" : [
            {
              "text" : "The AppImage bundler produces Linux ",
              "type" : "text"
            },
            {
              "identifier" : "https:\/\/appimage.org\/",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " which are self contained executable files that don’t require installation.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Dependencies",
          "level" : 2,
          "text" : "Dependencies",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The AppImage bundler relies on ",
              "type" : "text"
            },
            {
              "code" : "appimagetool",
              "type" : "codeVoice"
            },
            {
              "text" : ", and ",
              "type" : "text"
            },
            {
              "code" : "patchelf",
              "type" : "codeVoice"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Installing-appimagetool",
          "level" : 3,
          "text" : "Installing appimagetool",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Download a recent release of appimagetool from the ",
              "type" : "text"
            },
            {
              "identifier" : "https:\/\/github.com\/AppImage\/appimagetool\/releases",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " on GitHub.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Then move it to a location on your PATH and mark it as executable,",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "sudo mv appimagetool-$(uname -m).AppImage \/usr\/local\/bin\/appimagetool",
            "chmod +x \/usr\/local\/bin\/appimagetool"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "anchor" : "Installing-patchelf",
          "level" : 3,
          "text" : "Installing patchelf",
          "type" : "heading"
        },
        {
          "tabs" : [
            {
              "content" : [
                {
                  "code" : [
                    "sudo apt install patchelf"
                  ],
                  "syntax" : "shell",
                  "type" : "codeListing"
                }
              ],
              "title" : "Debian-based distros"
            },
            {
              "content" : [
                {
                  "code" : [
                    "sudo dnf install patchelf"
                  ],
                  "syntax" : "shell",
                  "type" : "codeListing"
                }
              ],
              "title" : "Fedora-based distros"
            }
          ],
          "type" : "tabNavigator"
        },
        {
          "anchor" : "Usage",
          "level" : 2,
          "text" : "Usage",
          "type" : "heading"
        },
        {
          "anchor" : "Create-an-AppImage",
          "level" : 2,
          "text" : "Create an AppImage",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler bundle --bundler linuxAppImage"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
