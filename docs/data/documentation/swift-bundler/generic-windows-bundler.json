    "title" : "Generic Window bundler"
  },
  "primaryContentSections" : [
    {
      "content" : [
        {
          "anchor" : "Overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The generic Windows bundler bundles your main executable, required dynamic libraries, and resources in a single flat directory, as is common for manually distributed Windows applications.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "It is the recommended bundler to use during Windows development, as it’s the fastest, and produces the most inspectable output bundle. If you wish, you can also use this bundler to distribute your application by zipping the resulting directory (as long as you tell your users to install required system dependencies).",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "This bundler forms the base for all of the other Windows bundlers.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Usage",
          "level" : 2,
          "text" : "Usage",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "In all of the following examples you can omit ",
              "type" : "text"
            },
            {
              "code" : "--bundler genericWindows",
              "type" : "codeVoice"
            },
            {
              "text" : " because it is the default when targeting Windows.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Create-an-app-bundle",
          "level" : 3,
          "text" : "Create an app bundle",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler bundle --bundler genericWindows"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "anchor" : "Run-on-your-host-machine",
          "level" : 3,
          "text" : "Run on your host machine",
          "type" : "heading"
        },
        {
          "code" : [
            "swift-bundler run --bundler genericWindows"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        }
      ],
      "kind" : "content"
    }
