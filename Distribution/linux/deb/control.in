Package: swift-bundler
Version: @@VERSION@@-@@REVISION@@
Architecture: @@ARCH@@
Maintainer: @@MAINTAINER@@
Installed-Size: @@INSTALLED_SIZE@@
Recommends: git, patchelf, rpm
Section: devel
